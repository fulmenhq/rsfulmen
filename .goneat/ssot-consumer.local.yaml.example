# Local SSOT sync configuration overrides
# Copy this file to ssot-consumer.local.yaml and customize as needed
# This file is gitignored and will not be committed
#
# Usage:
#   cp .goneat/ssot-consumer.local.yaml.example .goneat/ssot-consumer.local.yaml
#   # Edit the file to point to your local Crucible checkout

version: v1.1.0
sources:
  - name: crucible
    # Override to use local Crucible checkout instead of remote
    # Comment out 'repo' and 'ref' when using local_path
    local_path: ../crucible
    # repo: fulmenhq/crucible
    # ref: v0.2.21
    sync_path_base: lang/rust
    assets:
      - type: doc
        source_path: docs
        paths:
          - "architecture/**/*.md"
          - "standards/**/*.md"
          - "guides/**/*.md"
          - "sop/**/*.md"
        subdir: docs/crucible-rs
      - type: schema
        source_path: schemas
        paths:
          - "**/*"
        subdir: schemas/crucible-rs
      - type: config
        source_path: config
        paths:
          - "**/*"
        subdir: config/crucible-rs
      - type: metadata
        source_path: config/sync
        paths:
          - "**/*"
        subdir: .crucible/metadata
strategy:
  on_conflict: overwrite
  prune_stale: true
  verify_checksums: false
