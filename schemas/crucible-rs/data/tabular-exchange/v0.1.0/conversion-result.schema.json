{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fulmenhq.dev/crucible/data/tabular-exchange/v0.1.0/conversion-result.schema.json",
  "title": "Tabular Exchange Conversion Result",
  "description": "Structural shape of a conversion result document, wire format tabular-exchange.result/0. Structural validation is necessary and not sufficient: see semantic-validation.md in this directory for the rules this schema cannot express, including the order in which a result is read and the rules for matching a result to an output and to a request.",
  "type": "object",
  "properties": {
    "format": {
      "description": "Document kind and wire-format revision. A reader checks this member before any other.",
      "const": "tabular-exchange.result/0"
    },
    "contract": {
      "description": "Revision of this contract the producer followed. Distinct from the wire-format revision in format and from the adapter profile revision in profile.",
      "const": "tabular-exchange/0.1.0"
    },
    "status": {
      "description": "Outcome of the run.",
      "enum": [
        "ok",
        "refused",
        "failed",
        "cancelled"
      ]
    },
    "run_id": {
      "description": "Identity of the run, supplied by the caller or generated by the producer. Not a secret and not globally unique.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "inputs": {
      "description": "Digest and length of each input that was read to its end. An input that was not read completely has no entry.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/byteSummary"
        },
        "schema": {
          "$ref": "#/$defs/byteSummary"
        },
        "policy": {
          "$ref": "#/$defs/byteSummary"
        }
      },
      "additionalProperties": false
    },
    "output": {
      "$ref": "#/$defs/byteSummary"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "refusal": {
      "$ref": "#/$defs/refusal"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "required": [
    "format",
    "contract",
    "status",
    "run_id",
    "profile",
    "inputs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "output",
          "counts"
        ],
        "properties": {
          "inputs": {
            "required": [
              "source",
              "schema",
              "policy"
            ]
          }
        },
        "not": {
          "required": [
            "refusal"
          ]
        }
      },
      "else": {
        "required": [
          "refusal"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "output"
              ]
            },
            {
              "required": [
                "counts"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "refused"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "refusal": {
            "properties": {
              "category": {
                "enum": [
                  "invalid-input",
                  "schema-mismatch",
                  "unsupported-type",
                  "unsupported-representation",
                  "resource-limit"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "refusal": {
            "properties": {
              "category": {
                "enum": [
                  "resource-limit",
                  "io-failure",
                  "internal"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "refusal": {
            "properties": {
              "category": {
                "const": "cancelled"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "description": "A count or a length in bytes. At most 2^53 - 1 in a result of any status.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "description": "SHA-256 as 64 lowercase hexadecimal digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteSummary": {
      "description": "Digest and length of an exact sequence of bytes.",
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "profile": {
      "description": "The adapter profile the run used: its identifier, which ends in the profile revision, and the digest of the profile definition published by its owner. The definition itself is outside this contract.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*/r(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "counts": {
      "description": "What a completed conversion did, per column.",
      "type": "object",
      "properties": {
        "rows": {
          "$ref": "#/$defs/count"
        },
        "columns": {
          "description": "One entry per schema column, in schema order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/columnCounts"
          }
        }
      },
      "required": [
        "rows",
        "columns"
      ],
      "additionalProperties": false
    },
    "columnCounts": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "description": "How every non-null value of the column was represented in the output.",
          "enum": [
            "native",
            "text-fallback",
            "text-forced",
            "text"
          ]
        },
        "null": {
          "$ref": "#/$defs/count"
        },
        "empty": {
          "$ref": "#/$defs/count"
        },
        "numeric": {
          "$ref": "#/$defs/count"
        },
        "text_fallback": {
          "$ref": "#/$defs/count"
        },
        "text_forced": {
          "$ref": "#/$defs/count"
        },
        "quantized": {
          "$ref": "#/$defs/count"
        },
        "scale_changed": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "id",
        "representation",
        "null",
        "empty"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "numeric": [
          "text_fallback",
          "text_forced",
          "quantized",
          "scale_changed"
        ],
        "text_fallback": [
          "numeric",
          "text_forced",
          "quantized",
          "scale_changed"
        ],
        "text_forced": [
          "numeric",
          "text_fallback",
          "quantized",
          "scale_changed"
        ],
        "quantized": [
          "numeric",
          "text_fallback",
          "text_forced",
          "scale_changed"
        ],
        "scale_changed": [
          "numeric",
          "text_fallback",
          "text_forced",
          "quantized"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "enum": [
                  "text-fallback",
                  "text-forced"
                ]
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "required": [
              "numeric"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "text"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "not": {
              "required": [
                "numeric"
              ]
            }
          }
        }
      ]
    },
    "refusal": {
      "description": "Why a run did not complete. Never carries a value from the data.",
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "invalid-input",
            "schema-mismatch",
            "unsupported-type",
            "unsupported-representation",
            "resource-limit",
            "io-failure",
            "cancelled",
            "internal"
          ]
        },
        "rule": {
          "description": "Stable identifier of the rule that refused or failed.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "row": {
          "description": "Zero-based index of the row, when the refusal has one.",
          "$ref": "#/$defs/count"
        },
        "column": {
          "description": "Identifier of the column, when the refusal has one.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "category",
        "rule"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "description": "Members defined by an implementation, keyed by namespace. A consumer ignores a namespace it does not know and never needs one to interpret the other members. Bounded: at most 8 namespaces, strings of at most 256 code points, unsigned integers up to 9007199254740991, and content no deeper than depth 6 of the document. The bound of 256 values in total is semantic. The content of each namespace is otherwise defined by its owner.",
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "maxLength": 64
      },
      "patternProperties": {
        "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/extensionNamespace"
        }
      },
      "additionalProperties": false
    },
    "extensionNamespace": {
      "description": "The object a namespace owns, at depth 3 of the document.",
      "type": "object",
      "propertyNames": {
        "maxLength": 256
      },
      "additionalProperties": {
        "$ref": "#/$defs/extensionValue4"
      }
    },
    "extensionValue4": {
      "description": "A value at depth 4 of the document.",
      "anyOf": [
        {
          "$ref": "#/$defs/extensionScalar"
        },
        {
          "type": "object",
          "propertyNames": {
            "maxLength": 256
          },
          "additionalProperties": {
            "$ref": "#/$defs/extensionValue5"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionValue5"
          }
        }
      ]
    },
    "extensionValue5": {
      "description": "A value at depth 5 of the document.",
      "anyOf": [
        {
          "$ref": "#/$defs/extensionScalar"
        },
        {
          "type": "object",
          "propertyNames": {
            "maxLength": 256
          },
          "additionalProperties": {
            "$ref": "#/$defs/extensionValue6"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionValue6"
          }
        }
      ]
    },
    "extensionValue6": {
      "description": "A value at depth 6 of the document.",
      "anyOf": [
        {
          "$ref": "#/$defs/extensionScalar"
        },
        {
          "type": "object",
          "propertyNames": {
            "maxLength": 256
          },
          "additionalProperties": {
            "$ref": "#/$defs/extensionScalar"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionScalar"
          }
        }
      ]
    },
    "extensionScalar": {
      "description": "A value under extensions that is not an object or an array.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    }
  }
}
