# Auto detect text files and perform LF normalization
* text=auto

# Rust source files
*.rs text diff=rust

# Configuration files
*.toml text
*.yaml text
*.yml text
*.json text

# Markdown files
*.md text diff=markdown

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Lockfiles - exact content matters
Cargo.lock text -diff

# GitHub linguist configuration
# Exclude vendored Crucible assets from language statistics
docs/crucible-rs/** linguist-vendored
schemas/crucible-rs/** linguist-vendored
config/crucible-rs/** linguist-vendored
